# ==========================================
# LLM Provider API Keys & Settings
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# ==========================================
# Pinecone Vector DB
# ==========================================
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentflow

# ==========================================
# Security & Auth
# ==========================================
# Use a strong, random 32+ character string in production
SECRET_KEY=agentflow_super_secret_key_change_in_production_32bytes_min

# ==========================================
# Database Configuration (for Docker)
# ==========================================
POSTGRES_USER=agentflow_user
POSTGRES_PASSWORD=agentflow_password
POSTGRES_DB=agentflow_db

# Note: If running locally without Docker (e.g. via start_backend.bat),
# it defaults to using SQLite. If you want the local backend to connect 
# to the Docker Postgres database, uncomment the line below:
# DATABASE_URL=postgresql+asyncpg://agentflow_user:agentflow_password@localhost:5432/agentflow_db
